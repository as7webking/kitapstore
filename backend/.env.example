# Required. Local MongoDB or Atlas connection string; database name: kitapstore.
URI=mongodb://127.0.0.1:27017/kitapstore
# Required. Generate your own random secret; never commit a real value.
JWT_SECRET=
PORT=1001
# Exact frontend origin, used for CORS and OAuth redirects (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Optional: leave both empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:1001/api/v1/user/auth/google/callback

# Optional SMTP. Registration works without email; contact form needs SMTP.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Recipient for contact messages and registration notifications.
EMAIL_TO=
