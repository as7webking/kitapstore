# ПУСТОЙ ШАБЛОН BACKEND. Здесь нет настоящих секретов.
# Для облака: каждую строку перенести в Render → сервис API → Environment.
# Слева имя переменной (Key), справа значение (Value). Комментарии не переносить.
# Это памятка: пустой шаблон без заполнения не предназначен для запуска.

# Ввести: production (режим Node; ресурсы всё равно отдельные тестовые).
NODE_ENV=
# Ввести: 24 (версия Node на Render).
NODE_VERSION=
# Ввести: staging (включает защиту отдельной тестовой базы и почты).
APP_ENV=

# СЕКРЕТ. Atlas → тестовый кластер → Connect → Drivers → connection string.
# Формат: mongodb+srv://USER:PASSWORD@CLUSTER/kitapstore_test?retryWrites=true&w=majority
# Подставить тестового database user и его пароль, специальные символы кодировать.
# Пользователь должен иметь readWrite ТОЛЬКО на отдельную тестовую базу.
URI=
# Ввести: kitapstore_test. Путь базы внутри URI тоже обязан быть kitapstore_test.
MONGODB_DB_NAME=
# СЕКРЕТ. Новый отдельный случайный JWT-секрет, минимум 32 символа.
# Можно получить локально: openssl rand -hex 32. Не отправлять результат в чат/Git.
JWT_SECRET=

# Реальный стабильный HTTPS-домен frontend Vercel, без слеша в конце.
# Пример формы значения: https://YOUR-FRONTEND.vercel.app
FRONTEND_URL=
# Обычно оставить пустым. Дополнительные разрешённые HTTPS origins через запятую.
# Нельзя указывать *.vercel.app. Эта переменная не меняет адрес ссылок в письмах.
CORS_ORIGINS=
# Сначала 0. Значение 1 — только после проверки одного доверенного ingress proxy.
TRUST_PROXY_HOPS=
# На Render НЕ добавлять: платформа предоставляет PORT автоматически.
# Для локального backend можно использовать 1001.
PORT=

# Тестовая почта Ethereal; реальные письма получателям не доставляются.
# Ввести: smtp.ethereal.email
EMAIL_HOST=
# Ввести: 587
EMAIL_PORT=
# СЕКРЕТЫ. Данные отдельного тестового аккаунта из ethereal.email.
EMAIL_USER=
EMAIL_PASS=
# Ввести, например: KitapStore Test <no-reply@example.test>
EMAIL_FROM=
# Ввести, например: contact@example.test (получатель контактной формы).
EMAIL_TO=
# Ввести: 30 (допускается 1–120 минут).
PASSWORD_RESET_TTL_MINUTES=

# OAuth на этом этапе выключен: эти значения оставить пустыми/не добавлять в Render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# СЕКРЕТ ОЧЕРЕДИ. Отдельный ключ AES-256, одинаковый у API и recovery worker.
# Получить локально: openssl rand -base64 32. Результат не добавлять в Git/чат.
# Не использовать JWT_SECRET или ключ рабочего окружения для тестовой базы.
# Обязателен для восстановления и запуска worker; обычный вход работает без него.
RESET_MAIL_ENCRYPTION_KEY=

# Диагностика запуска не выводит значения переменных:
# STARTUP_CONFIGURATION — отсутствует переменная или неверен её формат.
# STARTUP_DATABASE — не удалось подключить MongoDB; проверить доступ/права вручную.
# STARTUP_QUEUE — worker не смог подготовить коллекцию/индексы очереди.
# STARTUP_FAILED — непредвиденная ошибка; исходный текст скрыт ради защиты секретов.
# API: npm start --prefix backend
# Отдельный процесс worker: npm run worker:reset-mail --prefix backend
# Обе команды выполнять из корня репозитория; worker не слушает HTTP-порт.
