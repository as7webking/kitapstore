# Required. Local MongoDB or Atlas connection string; database name: kitapstore.
URI=mongodb://127.0.0.1:27017/kitapstore
# Required. Generate your own random secret; never commit a real value.
JWT_SECRET=
PORT=1001
# Exact frontend origin, used for CORS and OAuth redirects (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Optional: leave both empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:1001/api/v1/user/auth/google/callback

# Optional SMTP. Registration works without email; contact form needs SMTP.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Recipient for contact messages and registration notifications.
EMAIL_TO=

# Password recovery: frontend origin above supplies /reset-password#token=...
# 1–120 minutes; newest request replaces any previous link.
PASSWORD_RESET_TTL_MINUTES=30
# Optional sender verified with your SMTP provider; falls back to EMAIL_USER.
EMAIL_FROM=

# Staging uses a separate Atlas project/user restricted to kitapstore_test.
# APP_ENV=staging activates guards: HTTPS frontend, test database and Ethereal only.
APP_ENV=development
# In staging set BOTH URI database path and this value to kitapstore_test.
MONGODB_DB_NAME=
# Extra exact frontend origins, comma-separated; never use wildcard preview domains.
CORS_ORIGINS=
# 0 locally. Set 1 only behind a verified single trusted ingress proxy.
TRUST_PROXY_HOPS=0
# Staging SMTP: EMAIL_HOST=smtp.ethereal.email, EMAIL_PORT=587,
# EMAIL_USER/EMAIL_PASS from a separate Ethereal test account (captures mail only).
# Current SMTP requires hosting with outbound 587; Render Free blocks this port.
